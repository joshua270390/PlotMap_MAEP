# Local testing with `vercel dev` (copy to .env.local). On Vercel set these in Project > Settings > Environment Variables.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
PROJECT_ID=1
# Set true only while debugging; shows the real Supabase error in the form.
DEBUG=false
